{
  "name": "npcink-ad",
  "version": "0.3.5",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "overrides": {
      "adm-zip": "0.6.0",
      "@puppeteer/browsers": "3.0.6",
      "brace-expansion@<2.0.0": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.3": "2.1.3",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.6",
      "ip-address": "10.3.1",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "linkify-it": "5.0.2",
      "minimatch@<4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "nanoid": "3.3.18",
      "serialize-javascript": "7.0.3",
      "shell-quote": "1.9.0"
    }
  },
  "scripts": {
    "audit:dependencies": "bash scripts/audit-dependencies.sh",
    "start": "wp-scripts start --webpack-src-dir=assets/js --webpack-output-dir=build",
    "build": "wp-scripts build --webpack-src-dir=assets/js --webpack-output-dir=build",
    "lint:js": "wp-scripts lint-js assets/js webpack.config.js",
    "lint:style": "wp-scripts lint-style assets/js/*.css",
    "test:js": "wp-scripts test-unit-js --runInBand",
    "test:e2e:editor": "tests/e2e/run.sh",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test:js && pnpm run lint:js && pnpm run lint:style"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@wordpress/block-editor": "wp-7.0",
    "@wordpress/blocks": "wp-7.0",
    "@wordpress/components": "wp-7.0",
    "@wordpress/core-data": "wp-7.0",
    "@wordpress/data": "wp-7.0",
    "@wordpress/edit-post": "wp-7.0",
    "@wordpress/editor": "wp-7.0",
    "@wordpress/i18n": "wp-7.0",
    "@wordpress/plugins": "wp-7.0",
    "@wordpress/scripts": "wp-7.0",
    "@wordpress/server-side-render": "wp-7.0",
    "@types/react": "18.3.27",
    "@types/wordpress__block-editor": "15.0.6",
    "@types/wordpress__blocks": "15.10.2",
    "@types/wordpress__edit-post": "8.4.2",
    "@types/wordpress__server-side-render": "6.15.0",
    "react": "18.3.1",
    "typescript": "5.3.3"
  }
}
